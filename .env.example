# Vercel + Turso deployment (GitHub push = live site)
#
# Turn on "auto deploy" by importing this repository in Vercel once.
# Create the database at https://turso.tech, then copy these two values
# from `turso db show <name> --url` and `turso db tokens create <name>`.

TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Same Groq key the app already uses for quick-add and the money coach.
GROQ_API_KEY=

# Google sign-in (free). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# → Create credentials → OAuth client ID → Web application.
# Authorised redirect URI must be exactly: <your-site-origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Gmails may open the ledger. Comma separated. Required for Google sign-in.
GOOGLE_ALLOWED_EMAILS=you@gmail.com,flatmate@gmail.com

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
